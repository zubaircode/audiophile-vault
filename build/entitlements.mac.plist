<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime: JIT Compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Hardened Runtime: Unsigned Executable Memory (V8 Engine) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Hardened Runtime: Disable Library Validation for bundled CLI binaries (ffmpeg, metaflac) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Automation: AppleScript / osascript Folder Selection Dialogs -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- File Access: Music Library read/write -->
    <key>com.apple.security.assets.music.read-write</key>
    <true/>

    <!-- File Access: User-selected folders/volumes (SD Cards, USB drives) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
