{
  "name": "audiophile-vault",
  "productName": "Audiophile Vault",
  "version": "1.0.0",
  "description": "Local, distraction-free audiophile music vault, lossless tag curator, and SD card sync hub for macOS",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,amber\" \"node --watch server/index.js\" \"vite\"",
    "dev:electron": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,magenta\" \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "server": "node --watch server/index.js",
    "client": "vite",
    "build": "vite build",
    "build:client": "vite build --outDir client/dist",
    "fetch:binaries": "bash scripts/fetch-mac-binaries.sh",
    "icon:build": "node scripts/generate-icon.mjs && bash scripts/build-icns.sh",
    "pack:mac": "npm run fetch:binaries && npm run icon:build && npm run build:client && electron-builder --mac --universal --dir --config electron-builder.config.js",
    "dist:mac": "npm run fetch:binaries && npm run icon:build && npm run build:client && electron-builder --mac dmg --universal --config electron-builder.config.js",
    "verify:release": "bash scripts/verify-release.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "music-metadata": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
